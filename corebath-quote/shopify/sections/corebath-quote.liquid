{%- comment -%}
  CoreBath quotation builder - Shopify Online Store 2.0 section.
  Upload these files to the theme's /assets folder:
    cbq.css, cbq-catalog.js, cbq-config.js, cbq-rates.js, cbq-engine.js, cbq-pdf.js, cbq-app.js
  Then add this file to /sections and add the "CoreBath quotation" section to any page.
  Customers tagged with the admin tag (default: corebath-admin) get the full admin tool.
{%- endcomment -%}

{{ 'cbq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cbq_mode = 'customer'
  if customer and customer.tags contains section.settings.admin_tag
    assign cbq_mode = 'admin'
  endif
-%}

<div class="page-width cbq-section" style="padding-top: {{ section.settings.padding }}px; padding-bottom: {{ section.settings.padding }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="h2" style="text-align:center;margin-bottom:8px;">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div class="rte" style="text-align:center;margin-bottom:16px;">{{ section.settings.intro }}</div>
  {%- endif -%}

  <div
    id="corebath-quote"
    data-mode="{{ cbq_mode }}"
    data-brand="{{ section.settings.default_brand }}"
    data-package="{{ section.settings.default_package }}"
    data-theme="{{ section.settings.theme }}"
    {% if section.settings.ai_endpoint != blank %}data-ai-endpoint="{{ section.settings.ai_endpoint }}"{% endif %}
  ></div>

  {%- if section.settings.enable_enquiry -%}
    {%- form 'contact', id: 'cbq-contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="cbq-sent" style="text-align:center;padding:12px;border-radius:8px;background:#eef7f1;color:#1d7a4a;">
          {{ section.settings.success_message }}
        </p>
      {%- endif -%}
      <input type="hidden" name="contact[name]">
      <input type="hidden" name="contact[email]">
      <input type="hidden" name="contact[phone]">
      <input type="hidden" name="contact[source]" value="CoreBath quotation builder">
      <textarea name="contact[body]" hidden></textarea>
    {%- endform -%}
  {%- endif -%}
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js" defer></script>
<script src="{{ 'cbq-catalog.js' | asset_url }}" defer></script>
<script src="{{ 'cbq-config.js' | asset_url }}" defer></script>
<script src="{{ 'cbq-rates.js' | asset_url }}" defer></script>
<script src="{{ 'cbq-engine.js' | asset_url }}" defer></script>
<script src="{{ 'cbq-pdf.js' | asset_url }}" defer></script>
<script src="{{ 'cbq-app.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CoreBath quotation",
  "tag": "section",
  "class": "section-corebath-quote",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your bathroom package" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Pick a brand and tier, swap any fitting, add extras and download an instant quotation with demolition, waterproofing, tiling and fixing included.</p>" },
    {
      "type": "select", "id": "default_brand", "label": "Default brand", "default": "Jaquar",
      "options": [
        { "value": "Jaquar", "label": "Jaquar" }, { "value": "Kohler", "label": "Kohler" },
        { "value": "Hindware", "label": "Hindware" }, { "value": "Cera", "label": "Cera" },
        { "value": "Parryware", "label": "Parryware" }, { "value": "Grohe", "label": "Grohe" }
      ]
    },
    {
      "type": "select", "id": "default_package", "label": "Default package", "default": "signature",
      "options": [
        { "value": "essential", "label": "Core Essential" },
        { "value": "signature", "label": "Core Signature" },
        { "value": "luxe", "label": "Core Luxe" }
      ]
    },
    {
      "type": "select", "id": "theme", "label": "Colour scheme", "default": "light",
      "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }, { "value": "auto", "label": "Follow device" } ]
    },
    { "type": "checkbox", "id": "enable_enquiry", "label": "Show \"Send to CoreBath\" button (uses the store contact form)", "default": true },
    { "type": "text", "id": "success_message", "label": "Message after sending", "default": "Thank you! Our team will call you to schedule a site visit." },
    { "type": "text", "id": "admin_tag", "label": "Customer tag for admin mode", "default": "corebath-admin", "info": "Log in to the store with a customer account carrying this tag to edit rates and add custom items." },
    { "type": "url", "id": "ai_endpoint", "label": "AI advisor URL (optional)", "info": "URL of the deployed ai/worker.js. Leave blank to use built-in recommendations only." },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "CoreBath quotation" } ]
}
{% endschema %}
